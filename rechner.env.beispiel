# Deine Rechner - wohin die Ausrollskripte in tools/ gehen.
#
# Kopieren nach `rechner.env` (steht nicht im Git). Jeder Abschnitt ist nur
# noetig, wenn du den Rechner hast; ein Skript sagt, was ihm fehlt.
# Shell-Format: Werte mit Leerzeichen in Anfuehrungszeichen.

# --- Ein Container-Wirt, z. B. Raspberry Pi mit Home Assistant OS -----------
# tools/pi-ausrollen.sh. Der SSH-Name aus ~/.ssh/config oder user@adresse.
IRIS_PI_HOST=mein-pi
# Wo iris auf dem Wirt liegt. Unter HAOS ist das der Share-Ordner.
IRIS_PI_PFAD=/mnt/data/supervisor/share/iris
# Weitere Ordner des Wirts, die Sitzungen dort bearbeiten duerfen, als
# wirt:container, durch Leerzeichen getrennt. Leer lassen, wenn keine.
IRIS_PI_PROJEKTE="/mnt/data/supervisor/share/meinprojekt:/projekte/meinprojekt"

# Ein zweites GitHub-Konto fuer den Wirt, z. B. das der Arbeit. Git schreibt
# dessen Repos dann auf den SSH-Namen github-arbeit um. Leer = nur ein Konto.
IRIS_GITHUB_ARBEIT=

# --- Ein Windows-PC mit OpenSSH ---------------------------------------------
# tools/pc-ausrollen.sh und tests/windows.py
IRIS_PC=mein-pc
IRIS_PC_URL=http://100.64.0.2:8780
