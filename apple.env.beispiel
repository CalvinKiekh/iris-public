# Apple-Identitaet fuer die iOS-, Watch- und Mac-App.
#
# Kopieren nach `apple.env` (steht nicht im Git) und die eigenen Werte
# eintragen. Das Format ist zugleich Shell und Make: kein `export`, keine
# Anfuehrungszeichen, keine Leerzeichen um das Gleichheitszeichen.
#
# Nur noetig fuer die eigenen Apps. Die Bruecke und die Weboberflaeche laufen
# ohne Apple-Konto - siehe docs/EINRICHTEN.md.

# Team-ID aus developer.apple.com -> Membership. Zehn Zeichen.
IRIS_TEAM=ABCDE12345

# Eine Bundle-ID, die dir gehoert. Die Apps haengen daran an:
#   iOS  <bundle>   Watch  <bundle>.watchkitapp   Mac  <bundle>.mac
# Sie dient auch als Name im Schluesselbund und als launchd-Label der
# Bruecke - aendere sie nicht mehr, sobald etwas installiert ist, sonst
# findet die App ihre gespeicherten Token nicht wieder.
IRIS_BUNDLE=org.beispiel.iris

# Das iPhone, auf das `make ios-device` spielt, und nur dieses.
# Die Kennung zeigt: xcrun devicectl list devices
IRIS_GERAET=00000000-0000-0000-0000-000000000000
